# ============== Gemini (chatbot) ==============
GEMINI_API_KEY=

# ============== Supabase (lưu chat history) ==============
# Lấy từ Supabase dashboard: Project Settings → API Keys
# PUBLISHABLE: client-safe. SECRET: server-only, KHÔNG expose
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ============== Admin panel ==============
# Dùng cho basic auth /admin — gõ random mạnh (16+ chars)
ADMIN_PASSWORD=
